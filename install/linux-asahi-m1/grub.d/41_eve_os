#!/bin/sh
# Installed to /etc/grub.d/41_eve_os on Asahi — finds Eve on the ESP by file path
# (no hardcoded partition UUID). Requires EFI/EVE/BOOTAA64.EFI on the ESP.
cat <<'GRUBEOF'
menuentry "Eve OS (AArch64 UEFI demo)" --class efi --class gnu-linux --id eve-aarch64-uefi {
  insmod part_gpt
  insmod fat
  insmod chain
  search --no-floppy --file /EFI/EVE/BOOTAA64.EFI --set=root
  chainloader /EFI/EVE/BOOTAA64.EFI
  boot
}
GRUBEOF
